SPEECH_KEY=<key del recurso Foundry / AI Services>
SPEECH_ENDPOINT=https://<recurso>.cognitiveservices.azure.com/
# Idiomas para la deteccion automatica (max 10). Un solo idioma = sin deteccion.
LANGUAGES=es-AR,en-US
DICTATE_HOTKEY=ctrl+alt+d
CANCEL_HOTKEY=ctrl+alt+x
QUIT_HOTKEY=ctrl+alt+shift+d
# Nombre (o fragmento) del microfono; vacio = default del sistema.
MIC_DEVICE=
# Corte de seguridad de costo: maximo de segundos de grabacion por dictado.
MAX_SECONDS=300
# Restaurar el clipboard anterior despues de pegar (1/0) y cuanto esperar antes.
RESTORE_CLIPBOARD=1
RESTORE_DELAY_MS=300
